# Optional local co-development override for the shared DSL workspace.
#
# Copy to `.cargo/config.toml` (gitignored) while changing both repositories.
# Remove the copied file before validating committed Git revisions and locks.

[patch."https://github.com/adamtc007/dsl"]
dsl_types = { path = "../../dsl/crates/dsl_types" }
dsl-core = { path = "../../dsl/crates/dsl-core" }
sem_os_types = { path = "../../dsl/crates/sem_os_types" }
sem_os_core = { path = "../../dsl/crates/sem_os_core" }
sem_os_ontology = { path = "../../dsl/crates/sem_os_ontology" }
sem_os_policy = { path = "../../dsl/crates/sem_os_policy" }
semantic-decision-contracts = { path = "../../dsl/crates/semantic-decision-contracts" }
semantic-embedder = { path = "../../dsl/crates/semantic-embedder" }
