# syntax=docker/dockerfile:1

FROM rust:1.95-bookworm AS chef
RUN cargo install cargo-chef --locked \
    && cargo install cargo-auditable --version 0.7.5 --locked
WORKDIR /build

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends libprotobuf-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release -p bpmn-lite-server-designer --recipe-path recipe.json
COPY . .
RUN cargo auditable build --release -p bpmn-lite-server-designer --bin bpmn-lite-demo-designer \
    && mkdir -p /build/out \
    && cp target/release/bpmn-lite-demo-designer /build/out/bpmn-lite-demo-designer \
    && strip /build/out/bpmn-lite-demo-designer

FROM gcr.io/distroless/cc-debian12:nonroot

ARG APP_REVISION
ARG SHARED_DSL_REVISION

LABEL org.opencontainers.image.title="bpmn-lite-designer" \
      org.opencontainers.image.revision="${APP_REVISION}" \
      io.bpmn-lite.shared-dsl-revision="${SHARED_DSL_REVISION}"

ENV BPMN_LITE_BUILD_REVISION="${APP_REVISION}" \
    BPMN_LITE_SHARED_DSL_REVISION="${SHARED_DSL_REVISION}" \
    BPMN_MAPPER_ROLLOUT="shadow" \
    BPMN_LITE_DEMO_BIND="0.0.0.0:8080" \
    BPMN_LITE_DEMO_ALLOW_NON_LOOPBACK="I_UNDERSTAND_THIS_IS_AN_UNAUTHENTICATED_DEMO"

WORKDIR /app
COPY --from=builder /build/out/bpmn-lite-demo-designer /usr/local/bin/

EXPOSE 8080

CMD ["bpmn-lite-demo-designer"]
